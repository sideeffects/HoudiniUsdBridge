        customData = {
            string userDocBrief = "Minimum number of deformer points to capture per groom point (radius will expand if needed)."
        }
    )
    uniform float houdini:hairdeform:captureradius = 1 (
        customData = {
            string userDocBrief = "Search radius for point capture when capture attributes are not present."
        }
    )
    rel houdini:hairdeform:deformerPrim (
        customData = {
            string userDocBrief = "Deformer curves or guides used for point deform and guide interpolation mesh methods."
        }
    )
    uniform string houdini:hairdeform:deformmethod = "" (
        customData = {
            string userDocBrief = "Method to use for the basic deformation."
        }
    )
    uniform float houdini:hairdeform:gsilengthpenaltyscale = 0 (
        customData = {
            string userDocBrief = """Guide Shape Interpolation: scale applied to the squared
        relative length difference between groom and guide curves."""
        }
    )
    uniform int houdini:hairdeform:gsimaxcandidates = 32 (
        customData = {
            string userDocBrief = """Guide Shape Interpolation: maximum number of candidate guide
        roots to consider in the spatial search."""
        }
    )
    uniform int houdini:hairdeform:gsimaxguides = 8 (
        customData = {
            string userDocBrief = """Guide Shape Interpolation: maximum number of guide influences
        per groom curve."""
        }
    )
    uniform int houdini:hairdeform:gsiminguides = 1 (
        customData = {
            string userDocBrief = """Guide Shape Interpolation: minimum number of guide influences
        kept per groom curve regardless of weight threshold."""
        }
    )
    uniform int houdini:hairdeform:gsinsamples = 20 (
        customData = {
            string userDocBrief = """Guide Shape Interpolation: number of arc-length samples used
        to compute shape distance between curves."""
        }
    )
    uniform float houdini:hairdeform:gsisearchradius = 0.2 (
        customData = {
            string userDocBrief = """Guide Shape Interpolation: spatial search radius around each
        groom curve root."""
        }
    )
    uniform float houdini:hairdeform:gsisigmascale = 0.1 (
        customData = {
            string userDocBrief = """Guide Shape Interpolation: Gaussian sigma scale factor applied
        to the median shape distance."""
        }
    )
    uniform float houdini:hairdeform:gsiweightthreshold = 0.1 (
        customData = {
            string userDocBrief = """Guide Shape Interpolation: minimum normalised weight below
        which a guide influence is discarded."""
        }
    )
    rel houdini:hairdeform:guideInterpMeshPrim (
        customData = {
            string userDocBrief = "Guide interpolation mesh with 'guides' and 'weights' array attributes for guide interpolation mesh deformation method."
        }
    )
    uniform string houdini:hairdeform:kerneltype = "exponentialbump" (
        allowedTokens = ["exponentialbump", "truncatedgaussian", "quadratic", "linear"]
        customData = {
            string userDocBrief = "Kernel type for smooth capture weight falloff."
        }
    )
    uniform float houdini:hairdeform:orientblend = 1 (
        customData = {
            string userDocBrief = """Blend between position-only guide deformation and
        orient-augmented guide deformation for BasisCurves point deform."""
        }
    )
    uniform float houdini:hairdeform:preserveclumpsdamping = 1 (
        customData = {
            string userDocBrief = "Damping for clump forces in preserve shape solve."
        }
    )
    uniform bool houdini:hairdeform:preserveclumpsenable = 0 (
        customData = {
            string userDocBrief = "Enable clump constraints during the solve."
        }
    )
    uniform int houdini:hairdeform:preserveclumpsmaxconstraints = 3 (
        customData = {
            string userDocBrief = "Maximum number of cross-curve clump constraints to keep per point."
        }
    )
    uniform int houdini:hairdeform:preserveclumpsmaxneighbors = 50 (
        customData = {
            string userDocBrief = "Maximum number of candidate neighbors to search per point for clumping."
        }
    )
    uniform float houdini:hairdeform:preserveclumpsstiffness = 0 (
        customData = {
            string userDocBrief = "Clump stiffness for volume preservation in preserve shape solve."
        }
    )
    uniform bool houdini:hairdeform:preserveshapeenable = 0 (
        customData = {
            string userDocBrief = "Enable preserve shape physics solve which targets the hair's original shape, while keeping deformation."
        }
    )
    uniform int houdini:hairdeform:preserveshapeiterations = 10 (
        customData = {
            string userDocBrief = "Number of preserve shape physics solve iterations."
        }
    )
    uniform float houdini:hairdeform:preserveshapekbend = 0.001 (
        customData = {
            string userDocBrief = "Bend stiffness for preserve shape solve (Cosserat model)."
        }
    )
    uniform float houdini:hairdeform:preserveshapekstretch = 0.01 (
        customData = {
            string userDocBrief = "Stretch stiffness for preserve shape solve (Cosserat model)."
        }
    )
    uniform bool houdini:hairdeform:preserveshapelockroots = 1 (

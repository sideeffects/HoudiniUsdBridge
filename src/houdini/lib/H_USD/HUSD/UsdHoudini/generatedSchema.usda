        customData = {
            string userDocBrief = "Hair roots will stick to this mesh."
        }
    )
    uniform bool houdini:hairdeform:smoothcapture = 0 (
        customData = {
            string userDocBrief = "Enable smooth RBF-based capture instead of BVH point capture."
        }
    )
    uniform float houdini:hairdeform:smoothcaptureradius = 0 (
        customData = {
            string userDocBrief = "Capture radius for smooth RBF capture method."
        }
    )
    uniform int houdini:hairdeform:smoothinglevel = 1 (
        customData = {
            string userDocBrief = "Number of smoothing subdivisions for smooth capture."

#usda 1.0

def Xform "World"
{
    def PointInstancer "Instancer"
    {
        int[] protoIndices = [0, 0, 0, 0, 0]
        point3f[] positions = [(0, 0, 0), (5, 0, 0), (10, 0, 0), (50, 0, 0), (100, 0, 0)]
        rel prototypes = [</World/Instancer/Prototypes/Proto>]

        def Scope "Prototypes"
        {
            def Cube "Proto"
            {
                double size = 1.0
            }
        }
    }

    def Cube "BoundPrim"
    {
        double size = 12.0
    }

    def PointInstancer "EmptyInstancer"
    {
        int[] protoIndices = []
        point3f[] positions = []
        rel prototypes = [</World/EmptyInstancer/Prototypes/Proto>]

        def Scope "Prototypes"
        {
            def Cube "Proto"
            {
                double size = 1.0
            }
        }
    }
}

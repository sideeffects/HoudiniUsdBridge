#usda 1.0

def Xform "World"
{
    def Cube "RefBox"
    {
        double size = 20.0
    }

    def PointInstancer "Instancer"
    {
        int[] protoIndices = [0, 0, 0, 0, 0]
        point3f[] positions = [(0, 0, 0), (5, 0, 0), (9, 0, 0), (50, 0, 0), (100, 0, 0)]
        rel prototypes = [</World/Instancer/Prototypes/Proto>]

        def Scope "Prototypes"
        {
            def Cube "Proto"
            {
                double size = 1.0
            }
        }
    }
}

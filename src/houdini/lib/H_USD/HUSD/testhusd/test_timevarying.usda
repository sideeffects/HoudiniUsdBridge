#usda 1.0

def Xform "World"
{
    # Only static attributes: must never match %timevarying.
    def Xform "StaticPrim"
    {
        custom double myStatic = 5.0
        double size = 1.0
    }

    # Time varying transform (two samples), no other animated attributes.
    def Xform "AnimatedXform"
    {
        double3 xformOp:translate.timeSamples = {
            1: (0, 0, 0),
            2: (1, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Time varying points (two samples), static transform-unrelated attribute.
    def Points "AnimatedPoints"
    {
        point3f[] points.timeSamples = {
            1: [(0, 0, 0), (1, 0, 0), (2, 0, 0)],
            2: [(0, 1, 0), (1, 1, 0), (2, 1, 0)],
        }
        double size = 1.0
    }

    # A single authored time sample is NOT time varying: must never match,
    # in either the default or the counttimesamples mode.
    def Xform "SingleSample"
    {
        custom double mySingle.timeSamples = {
            1: 5.0,
        }
    }
}
